# --- Daemon ---
# Listen address for /metrics, e.g. :9091 (required for CLI and Compose).
PROMETHEUS_PORT=

# --- RabbitMQ ---
# AMQP URL to an existing broker reachable by the daemon container.
# Inside Docker, localhost refers to the daemon container, not the broker.
RABBITMQ_URL=

# Names of existing task and result queues. The daemon does not create queues.
RABBITMQ_QUEUE_NAME=
RABBITMQ_RESULTS_QUEUE=

# --- Engine ---
# For local CLI execution, set the path to a compatible engine binary.
# Compose sets this to /app/cli-app from the Dockerfile automatically.
ENGINE_ANTIGINX_CALL=

# The engine uses pipe mode when this variable is present (even if empty).
# Compose sets it automatically; for local CLI execution, uncomment:
# PIPE_COMMUNICATION=true

# --- Optional daemon tuning ---
# Leave empty to use the daemon's built-in defaults.
PREFETCH_COUNT=
TASK_CHANNEL_SIZE=
WORKER_POOL=

# --- CVE lookup (optional) ---
# NVD API key; increases the NVD request limit.
ANTIGINX_NVD_API_KEY=

# --- dns-reputation test (optional) ---
# RDAP entry point used for domain and address registration lookups.
ANTIGINX_RDAP_URL=

# --- urlhaus test ---
# abuse.ch Auth-Key (free at https://auth.abuse.ch/); without it the test reports that it was skipped.
ANTIGINX_URLHAUS_AUTH_KEY=

# URLhaus API entry point (optional, defaults to https://urlhaus-api.abuse.ch).
ANTIGINX_URLHAUS_URL=
